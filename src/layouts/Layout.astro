---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "Reynald Abner Tananda - Full-Stack Software Engineer portfolio focusing on Web, Mobile, API, and Cloud Application Architecture.",
  image = "/assets/profile.webp"
} = Astro.props;

const siteUrl = "https://www.abner.my.id";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Reynald Abner Tananda",
      "alternateName": ["Reynald Abner", "Reynald Abner Tananda Portfolio"],
      "url": `${siteUrl}/`,
      "image": ogImageUrl,
      "jobTitle": "Full-Stack Software Engineer & Mobile Developer",
      "email": "mailto:reynald030685@gmail.com",
      "sameAs": [
        "https://github.com/reynaldabnerrr",
        "https://www.linkedin.com/in/reynald-abner-tananda-a060b4227/",
        "https://www.instagram.com/reynaldabnerr/"
      ],
      "knowsAbout": [
        "Software Engineering",
        "Full-Stack Web Development",
        "Cyber Security",
        "React",
        "TypeScript",
        "Astro",
        "Node.js",
        "API Security & Development"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": `${siteUrl}/`,
      "name": "Reynald Abner Tananda Portfolio",
      "description": description,
      "publisher": {
        "@id": `${siteUrl}/#person`
      },
      "inLanguage": ["id", "en"]
    }
  ]
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || (!saved && window.matchMedia('(prefers-color-scheme: light)').matches)) {
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.remove('light');
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Search Verification -->
    <meta name="google-site-verification" content="google16393af97fa05edd" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Reynald Abner Tananda" />
    <meta name="keywords" content="Reynald Abner Tananda, Reynald Abner, Full-Stack Software Engineer, Cyber Security Specialist, Web Developer Indonesia, React Developer, Astro Developer, Software Engineer Portfolio, Cybersecurity, Web Development" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#030712" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Reynald Abner Tananda Portfolio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="id_ID" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <!-- Security & Referrer Policy -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Google Fonts Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Syne:wght@700;800&display=swap" />
    
  </head>
  <body class="bg-[#030712] text-gray-100 selection:bg-indigo-500/30 selection:text-indigo-200 min-h-screen relative overflow-x-hidden">
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
